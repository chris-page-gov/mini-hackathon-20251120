# Enforce consistent line endings across platforms
* text=auto

# Treat common data and binary assets appropriately
*.csv text eol=lf
*.tsv text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ipynb text eol=lf
*.bat text eol=crlf

# Binary formats
*.potx binary
*.docx binary
*.pptx binary
*.zip binary
